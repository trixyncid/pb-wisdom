generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PENDING
  MEMBER
  ADMIN
  REJECTED
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum FeeStatus {
  UNPAID
  SUBMITTED
  VERIFIED
  REJECTED
}

enum RsvpStatus {
  GOING
  WAITLIST
  NOT_GOING
}

enum EventType {
  SPARRING
  TOURNAMENT
  GATHERING
  OTHER
}

enum AttendanceStatus {
  GOING
  ATTENDED
  ABSENT
  MAYBE
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum InviteType {
  CLUB
  SESSION
  EVENT
}

enum NotificationType {
  IURAN
  EVENT
  MATCH
  ANNOUNCEMENT
  SYSTEM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(PENDING)
  locale        String    @default("id")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       MemberProfile?
  invitesCreated Invite[] @relation("InviteCreator")
  feeDues       FeeDue[]
  verifiedFees  FeeDue[]  @relation("FeeVerifier")
  sessionAttendance SessionAttendance[]
  eventRsvps    EventRsvp[]
  eventPhotos   EventPhoto[]
  matchesLogged Match[]   @relation("MatchLogger")
  matchPlayers  MatchPlayer[]
  notifications Notification[]
  announcements Announcement[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MemberProfile {
  id        String       @id @default(cuid())
  userId    String       @unique
  nickname  String
  phone     String?
  imageUrl  String?
  skill     SkillLevel   @default(BEGINNER)
  status    MemberStatus @default(ACTIVE)
  joinDate  DateTime     @default(now())
  notes     String?      @db.Text
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id            String     @id @default(cuid())
  code          String     @unique
  type          InviteType @default(CLUB)
  remainingUses Int        @default(50)
  expiresAt     DateTime?
  autoApprove   Boolean    @default(false)
  createdById   String
  eventId       String?
  sessionId     String?
  createdAt     DateTime   @default(now())

  createdBy User             @relation("InviteCreator", fields: [createdById], references: [id])
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session   TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model TrainingSession {
  id        String   @id @default(cuid())
  title     String
  weekday   Int
  startTime String
  endTime   String?
  venue     String
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences TrainingOccurrence[]
  invites     Invite[]
}

model TrainingOccurrence {
  id        String   @id @default(cuid())
  sessionId String
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  session     TrainingSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendances SessionAttendance[]

  @@unique([sessionId, date])
}

model SessionAttendance {
  id           String           @id @default(cuid())
  occurrenceId String
  userId       String
  status       AttendanceStatus @default(GOING)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  occurrence TrainingOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, userId])
}

model FeePeriod {
  id                   String   @id @default(cuid())
  label                String
  amount               Int
  dueDate              DateTime
  paymentInstructions  String   @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  dues FeeDue[]
}

model FeeDue {
  id             String    @id @default(cuid())
  periodId       String
  userId         String
  status         FeeStatus @default(UNPAID)
  proofUrl       String?
  rejectReason   String?
  verifiedById   String?
  verifiedAt     DateTime?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  period     FeePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User?     @relation("FeeVerifier", fields: [verifiedById], references: [id])

  @@unique([periodId, userId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        EventType @default(SPARRING)
  startsAt    DateTime
  endsAt      DateTime?
  location    String
  capacity    Int?
  extraFee    Int?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rsvps   EventRsvp[]
  photos  EventPhoto[]
  matches Match[]
  invites Invite[]
}

model EventRsvp {
  id        String     @id @default(cuid())
  eventId   String
  userId    String
  status    RsvpStatus @default(GOING)
  attended  Boolean?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventPhoto {
  id         String   @id @default(cuid())
  eventId    String
  uploaderId String
  imageUrl   String
  caption    String?
  createdAt  DateTime @default(now())

  event    Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploader User  @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
}

model Match {
  id          String      @id @default(cuid())
  type        MatchType
  status      MatchStatus @default(PENDING)
  playedAt    DateTime    @default(now())
  score       String
  eventId     String?
  loggedById  String
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  event    Event?        @relation(fields: [eventId], references: [id])
  loggedBy User          @relation("MatchLogger", fields: [loggedById], references: [id])
  players  MatchPlayer[]
}

model MatchPlayer {
  id        String  @id @default(cuid())
  matchId   String
  userId    String
  team      Int
  confirmed Boolean @default(false)
  won       Boolean?

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  body        String   @db.Text
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id])
}
