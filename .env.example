# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://pbwisdom:pbwisdom@localhost:5432/pbwisdom?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional locally; required in production for Google sign-in)
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

# Required for /api/cron/daily (the endpoint refuses to run without it).
# The scheduler must send "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# DigitalOcean Spaces for uploaded images (optional locally; empty = images are
# stored in the database). Use a separate folder so local tests do not mix
# with production files. Production values: deploy/.env.production.example.
SPACES_REGION="sgp1"
SPACES_BUCKET=""
SPACES_KEY=""
SPACES_SECRET=""
SPACES_CDN_URL=""
SPACES_PREFIX="pb-wisdom-dev"

# Email via Resend (optional locally: without a key mails are only logged).
RESEND_API_KEY=""
EMAIL_FROM="PB Wisdom <noreply@trixync.id>"
EMAIL_REPLY_TO=""

# UI-only demo (in-memory data, NO real auth). Server-only and read at runtime.
# Never set it on a real deployment: with NODE_ENV=production the app refuses to
# start if DATABASE_URL is also set.
# DEMO_MODE="1"

# Production settings: see deploy/.env.production.example and DEPLOY.md.
