# Local Docker Postgres (see docker-compose.yml)
DATABASE_URL="postgresql://pbwisdom:pbwisdom@localhost:5432/pbwisdom?schema=public"
DIRECT_URL="postgresql://pbwisdom:pbwisdom@localhost:5432/pbwisdom?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional locally; required in production for Google sign-in)
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Required for /api/cron/daily (the endpoint refuses to run without it).
# The scheduler must send "Authorization: Bearer <CRON_SECRET>".
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# UI-only demo (in-memory data, NO real auth). Server-only and read at runtime.
# Never set it on a real deployment: with NODE_ENV=production the app refuses to
# start if DATABASE_URL is also set.
# DEMO_MODE="1"

# Production (Vercel + Railway): use Railway pooled URL for DATABASE_URL
# and unpooled for DIRECT_URL / migrations. Enable PgBouncer on Railway.
# RESEND_API_KEY=""
# UPLOADTHING_TOKEN="" or Cloudinary credentials
