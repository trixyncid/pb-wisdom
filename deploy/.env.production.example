# Copy to ~/pb-wisdom/.env on the server (chmod 600). Never commit the real file.

# Image to run; the deploy workflow pins this to the commit SHA.
APP_IMAGE=ghcr.io/trixyncid/pb-wisdom:latest

# Postgres (only reachable inside the compose network).
# Generate with: openssl rand -hex 24 (URL-safe; it goes into DATABASE_URL)
POSTGRES_USER=pbwisdom
POSTGRES_PASSWORD=
POSTGRES_DB=pbwisdom
# DATABASE_URL is built from these by docker-compose.prod.yml.

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://pb-wisdom.trixync.id

# Google sign-in (optional). Authorized redirect URI:
#   https://pb-wisdom.trixync.id/api/auth/callback/google
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Shared with the cron container. Generate with: openssl rand -hex 32
CRON_SECRET=

# Never set DEMO_MODE in production.

# DigitalOcean Spaces for uploaded images (profile photos, transfer proofs,
# event albums). Without these, images are stored in the database instead.
# Create a key limited to this bucket: Spaces → Access Keys → "Limited access".
SPACES_REGION=sgp1
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
# Optional. With the Spaces CDN enabled:
#   https://<bucket>.sgp1.cdn.digitaloceanspaces.com
# Default: https://<bucket>.<region>.digitaloceanspaces.com
SPACES_CDN_URL=
# Optional folder inside the bucket (default: pb-wisdom).
# SPACES_PREFIX=pb-wisdom

# Email via Resend (password reset, new sign-ups, approvals, iuran). Without
# RESEND_API_KEY nothing is sent (mails are logged and marked SKIPPED).
# EMAIL_FROM must use the domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="PB Wisdom <noreply@trixync.id>"
# Optional: where replies go (e.g. the club's Gmail).
EMAIL_REPLY_TO=
